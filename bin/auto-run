#!/usr/bin/env bash
# Run a build/test command and speak its final status using the offline voice.
set +e
if [[ $# -eq 0 ]]; then
  echo "Usage: auto-run <command> [args...]" >&2
  exit 2
fi

"$@"
status=$?

cmd_summary="$*"
if [[ ${#cmd_summary} -gt 40 ]]; then
  cmd_summary="$1"
fi

if [[ $status -eq 0 ]]; then
  "$HOME/Automation/scripts/advanced-events.py" --say "Command completed successfully: $cmd_summary"
else
  "$HOME/Automation/scripts/advanced-events.py" --say "Command failed with exit code $status: $cmd_summary"
fi

exit "$status"
