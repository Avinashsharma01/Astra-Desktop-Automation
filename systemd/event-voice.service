[Unit]
Description=Astra Hardware & Health Event Voice Monitor
After=automation-astra.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do test -f "$XDG_RUNTIME_DIR/automation-astra.ready" && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/python3 %h/Automation/scripts/event-voice.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
